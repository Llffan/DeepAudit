# ============================================================
# DeepAudit MVP repository .gitignore
# Owners: Phase 0 (this file). Backend/frontend have their own
# .gitignore for tool-specific entries.
# ============================================================

# ---- Secrets ----
.env
.env.local
.env.*.local
# application-docker.yml 现已只含 ${ENV_VAR:} 占位符，不再含明文密钥，
# 重新纳入版本库便于团队同步 docker profile 配置。任何向其填写真实
# 密钥的提交都会破坏此约定 —— 提交前务必 git diff 检查。
# application-prod.yml 仍预防性忽略；本仓库目前没有此文件。
backend/src/main/resources/application-prod.yml
*.pem
*.key
.token
*.token
secrets/

# ---- Backend (Maven / Spring) ----
backend/target/
backend/*.iml
backend/.idea/
backend/.mvn/wrapper/maven-wrapper.jar
backend/HELP.md

# ---- Frontend (Node / Vite) ----
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.cache/
frontend/.turbo/

# ---- Runtime artifacts ----
uploads/
backend/uploads/
*.log
logs/

# ---- Data — PHI-bearing artifacts must NEVER be committed ----
# Demo PDFs are kept LOCAL to the operator's machine; the data/samples
# folder is shipped only as a placeholder + README (see C-regulatory-003).
data/samples/*.pdf
data/samples/*.PDF
data/samples/*.png
data/samples/*.jpg
# Ground-truth JSON paired with sample PDFs by scripts/sample_pdf/.
# These mirror PHI-bearing field values, so keep them out of git too.
data/samples/*.json

# ---- ICD seed: CSV is allowed (it's public reference data); the offline
#      embedding-generated SQL pack is NOT committed (Phase 1 generates
#      it locally; size is large and not source-of-truth).
data/icd/*.sql
data/icd/.cache/

# ---- IDE / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- Docker ----
.docker-compose-state/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Claude Code workspace ----
.claude/

# ---- Claude Code conversation exports (/export command) ----
# Matches root-level files named YYYY-MM-DD-*.txt
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
