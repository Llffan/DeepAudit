# Copy this file to .env (which is gitignored) before `docker compose up -d`.
# DASHSCOPE_API_KEY is consumed by the backend; obtained per Plan 00.4.

DASHSCOPE_API_KEY=

# C-regulatory-002: leave as `off` if you confirmed the DashScope console
# "数据改进计划" toggle is OFF. If you must run with it ON for some reason,
# set this to `on` and the backend will emit a startup WARN log.
DASHSCOPE_DATA_IMPROVEMENT=off
