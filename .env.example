# Copy this file to .env (which is gitignored) before `docker compose up -d`.
# 后端只需要其中**两个**：DEEPSEEK_API_KEY（chat / NL→DSL / 各类对话助手）
# 与 DASHSCOPE_API_KEY（embedding / ICD 字典向量化 / 编码助手语义召回）。
# 任一缺失对应能力会优雅降级，规则引擎本身不依赖任何 key。

# ---- DeepSeek（chat）----
# 申请：https://platform.deepseek.com/  →  API Keys
# 用途：规则 NL→DSL、自定义算子 bodyDsl 推荐、错误解释、ICD 编码助手对话
DEEPSEEK_API_KEY=

# ---- 阿里云百炼 DashScope（embedding）----
# 申请：https://bailian.console.aliyun.com/  →  API-Key 管理
# 模型默认 text-embedding-v3（1024 维），与 V10 migration 列宽对齐。
# 用途：icd_dict 字典向量化、R006 在线语义一致性、ICD 编码助手 searchByName
DASHSCOPE_API_KEY=

# C-regulatory-002: 留 off 表示已确认 DashScope 控制台"数据改进计划"开关已关。
# 如果必须开着跑，设成 on 后端启动时会打印 WARN 日志。
DASHSCOPE_DATA_IMPROVEMENT=off

# ---- Google Gemini（仅遗留）----
# 仅 PDF 多模态抽取等少数路径仍引用；不需要可留空。
GEMINI_API_KEY=
