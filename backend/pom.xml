<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================================
         Pinned versions (D-005 / C-env-001 / R6 defense): NO `latest`,
         NO version-range. All third-party libs declared with explicit
         versions OR managed via the spring-boot-starter-parent BOM.
         ==================================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.deepaudit</groupId>
    <artifactId>deepaudit-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>deepaudit-backend</name>
    <description>DeepAudit 病案首页质控 MVP backend</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- pinned third-party versions (NOT managed by Boot 3.2.5 BOM) -->
        <spring-boot.version>3.2.5</spring-boot.version>
        <postgresql.version>42.7.3</postgresql.version>
        <langchain4j.version>0.36.2</langchain4j.version>
        <pgvector.version>0.1.6</pgvector.version>
        <pdfbox.version>3.0.3</pdfbox.version>
    </properties>

    <dependencies>
        <!-- Spring Boot starters (versions managed by parent BOM = 3.2.5) -->
        <!-- D-014: NO Spring Security starter on classpath (single-user demo, no auth). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- T1.5: switched from starter-jdbc to starter-data-jpa per plan §4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- pgvector Java client: provides PGvector (extends PGobject) for
             marshalling vector(N) columns over JDBC. Used by VectorUserType
             to map VECTOR(1024) <-> float[]. -->
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>${pgvector.version}</version>
        </dependency>

        <!-- Flyway DB migrations (Phase 1 T1.1). Version managed by the
             spring-boot-starter-parent BOM (Boot 3.2.5 -> Flyway 9.22.x).
             Flyway 9 bundles PostgreSQL support; the separate
             flyway-database-postgresql module only exists from Flyway 10+
             and is NOT needed here. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver (pinned) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- langchain4j core + OpenAI-compatible integration.
             DeepSeek V3 uses the OpenAI-compatible API (base-url override).
             Chat and streaming share the same deepseek-chat model.
             DeepSeek has no embedding API; EmbeddingService gracefully
             degrades when no EmbeddingModel bean is present. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- T3.1: PDFBox for PDF -> PNG page rendering before Gemini multimodal call. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- ICD 字典 JSONL 单点维护在 docs/icd_dict/，构建时镜像到
             classpath:data/icd_dict/，由 IcdDictLoader 从 classpath 加载。
             这样数据不双份维护，且打包成 jar 后仍可读。 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../docs/icd_dict</directory>
                <targetPath>data/icd_dict</targetPath>
                <includes>
                    <include>*.jsonl</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
